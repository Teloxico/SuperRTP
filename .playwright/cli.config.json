{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "channel": "chrome"
    },
    "contextOptions": {
      "viewport": {
        "width": 1440,
        "height": 900
      }
    }
  },
  "outputDir": "artifacts/browser",
  "outputMode": "file",
  "console": {
    "level": "warning"
  },
  "timeouts": {
    "action": 8000,
    "navigation": 60000
  },
  "allowUnrestrictedFileAccess": false
}
