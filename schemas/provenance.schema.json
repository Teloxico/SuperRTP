{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superrtp.org/schemas/provenance.schema.json",
  "title": "SuperRTP Provenance Record",
  "type": "object",
  "required": [
    "asset_id",
    "canonical_path",
    "sha256",
    "license",
    "source_type",
    "clean_room_attestation",
    "test_only"
  ],
  "properties": {
    "asset_id": { "type": "string" },
    "canonical_path": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "license": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["project_synthetic", "externally_licensed", "ai_generated"]
    },
    "creator": { "type": "string" },
    "creation_tool": { "type": "string" },
    "upstream_source": {
      "type": "object",
      "required": ["author", "url", "license_evidence"],
      "properties": {
        "repository": { "type": "string" },
        "author": { "type": "string" },
        "url": { "type": "string" },
        "license_evidence": { "type": "string" },
        "commit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generation_metadata": {
      "type": "object",
      "required": ["model", "provider", "prompt", "parameters", "date"],
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "prompt": { "type": "string" },
        "parameters": { "type": "object" },
        "date": { "type": "string" }
      },
      "additionalProperties": false
    },
    "clean_room_attestation": {
      "type": "object",
      "required": [
        "proprietary_rtp_derived",
        "openrtp_derived"
      ],
      "properties": {
        "proprietary_rtp_derived": { "type": "boolean", "const": false },
        "openrtp_derived": { "type": "boolean", "const": false },
        "external_art_used": { "type": "boolean" },
        "ai_generation_used": { "type": "boolean" },
        "geometric_primitives_only": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "specification": {
      "type": "object",
      "properties": {
        "rpg_engine": { "type": "string" },
        "asset_class": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "test_only": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source_type": { "const": "project_synthetic" } }
      },
      "then": {
        "required": ["creation_tool"]
      }
    },
    {
      "if": {
        "properties": { "source_type": { "const": "externally_licensed" } }
      },
      "then": {
        "required": ["upstream_source"]
      }
    },
    {
      "if": {
        "properties": { "source_type": { "const": "ai_generated" } }
      },
      "then": {
        "required": ["generation_metadata"]
      }
    }
  ],
  "additionalProperties": false
}
